<body class="bg-brandDark text-slate-100 font-sans antialiased selection:bg-brandPrimary selection:text-white">

    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-brandDark/80 backdrop-blur-xl border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-cyan-400 flex items-center justify-center font-black text-xl text-white shadow-lg shadow-indigo-500/20">
