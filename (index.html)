    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandPrimary: '#6366F1',
                        brandAccent: '#06B6D4',
                        brandDark: '#0B0F19',
                        brandCard: '#111827'
                    }
